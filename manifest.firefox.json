{
  "manifest_version": 3,
  "name": "Backlog Browser for Epic Games",
  "version": "0.1.0",
  "description": "Browse your claimed Epic Games freebies with Steam reviews and ProtonDB Deck compatibility.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.epicgames.com/*",
    "https://store.steampowered.com/*",
    "https://www.protondb.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{fcf33aa2-e460-4348-9f1a-611ce42df2ab}",
      "strict_min_version": "109.0"
    }
  }
}
